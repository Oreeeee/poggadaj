{{ extends "./base.jet" }}

{{ block title() }} {{ t(.Language, "account-panel") }} {{ end }}

{{ block documentBody() }}
<h1>{{ t(.Language, "account-panel") }}</h1>
<br />

<p>
    {{ t(.Language, "your-uin") }}: {{ .Data.UIN }} <br />
    {{ t(.Language, "joined-date") }}: {{ formatDate(.Data.JoinedDate) }} <br />
    {{ if .Data.Email != "" }}
        E-mail: {{ .Data.Email }}
    {{ else }}
        {{ t(.Language, "no-provided-email") }}
    {{ end }}
</p>

<div>
    <a href="/dashboard/changePassword">{{ t(.Language, "gg-changepass") }}</a> <br />
    <form action="/logout" method="POST" style="display: inline;">
      <button type="submit" style="border: 0; background: none; padding: 0; color: blue; text-decoration: underline; cursor: pointer;">
        {{ t(.Language, "logout") }}
      </button>
    </form>
    {*<a href="/dashboard/changePassword">My details</a>*}
</div>

{{ end }}
