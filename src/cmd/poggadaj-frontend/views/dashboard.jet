{{ extends "./base.jet" }}

{{ block title() }} {{ t(.Language, "account-panel") }} {{ end }}

{{ block documentBody() }}
<h1>{{ t(.Language, "account-panel") }}</h1>
<br />

<p>
    {{ t(.Language, "your-uin") }}: {{ .Data.UIN }} <br />
    {{ t(.Language, "joined-date") }}: {{ .Data.JoinedDate }}
</p>

<div>
    <a href="/dashboard/changePassword">{{ t(.Language, "gg-changepass") }}</a> <br />
    {*<a href="/dashboard/changePassword">My details</a>*}
</div>

{{ end }}
