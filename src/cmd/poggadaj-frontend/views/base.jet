<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
    <head>
        <title>{{ yield title() }} - poGGadaj</title>
        <link rel="stylesheet" href="/static/style.css" />
        <link rel="icon" href="/static/favicon.png" />
    </head>
    <body>
        <div id="main">
            <div id="header">
                <hgroup>
                    <h1>poGGadaj</h1>
                    <h2>{{ t(.Language, "header-subtext") }}</h2>
                    {{ if !isOfficialInstance }} {* Kindly respect this setting, please *}
                        <h2>{{ "(" + t(.Language, "third-party-instance") + ")" }}</h2>
                    {{ end }}
                </hgroup>

                <div class="linksbar">
                    <a href="/"> {{ t(.Language, "home") }} </a>

                    <a href="/download"> {{ t(.Language, "download") }} </a>

                    {{ if .HasAuth }}
                        <a href="/dashboard"> {{ t(.Language, "my-acc") }} </a>
                    {{ else }}
                        <a href="/login"> {{ t(.Language, "login") }} </a>
                    {{ end }}
                </div>
            </div>

            <hr />

            <div id="content">{{ yield documentBody() }}</div>

            <br/ ><hr />

            <div id="footer">
                <p>
                    {{ t(.Language, "footer-line-1") }} <br/>
                    {{ t(.Language, "footer-line-2") }} <br/>
                    {{ t(.Language, "footer-line-3") }} <br/>
                    {{ t(.Language, "footer-line-4") }} <br/>
                    <a href="https://codeberg.org/or3e/poggadaj">{{ t(.Language, "source-code") }}</a>
                </p>
            </div>
        </div>
    </body>
</html>
