{{extends "./base.jet"}}

{{ block title() }} {{ t(.Language, "login") }} {{ end }}

{{block documentBody()}}
<h1>{{ t(.Language, "login") }}</h1>
<form action="/do-login" class="login-form">
  <label for="username">{{ t(.Language, "web-username") }}</label>
  <input type="text" id="username">
  <br><br>
  <label for="password">{{ t(.Language, "web-password") }}</label>
  <input type="password" id="password">
  <br><br>
  <input type="submit" value="{{ t(.Language, "login") }}">
</form>
<p>{{ t(.Language, "no-account") }}</p><a href="/register">{{ t(.Language, "register") }}!</a>
{{end}}
