{{extends "./base.jet"}}

{{ block title() }} {{ t("en", "login") }} {{ end }}

{{block documentBody()}}
<h1>{{ t("en", "login") }}</h1>
<form action="/do-login" class="login-form">
  <label for="username">{{ t("en", "web-username") }}</label>
  <input type="text" id="username">
  <br><br>
  <label for="password">{{ t("en", "web-password") }}</label>
  <input type="password" id="password">
  <br><br>
  <input type="submit" value="{{ t("en", "login") }}">
</form>
<p>{{ t("en", "no-account") }}</p><a href="/register">{{ t("en", "register") }}!</a>
{{end}}
