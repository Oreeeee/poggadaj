{{ extends "./base.jet" }}
{{ import "widgets/warning.jet" }}

{{ block title() }} {{ t(.Language, "registration") }} {{ end }}

{{ block documentBody() }}

{{ if .Data["missingValues"] == true }}
    {{ yield warning(wType="serious", message=t(.Language, "reg-missing-values")) }} <br>
{{ end }}

{{ if .Data["usernameTooLong"] == true }}
    {{ yield warning(wType="serious", message=t(.Language, "reg-username-long")) }} <br>
{{ end }}

{{ if .Data["badEmail"] == true }}
    {{ yield warning(wType="serious", message=t(.Language, "reg-bad-email")) }} <br>
{{ end }}

{{ if .Data["badPasswordLen"] == true }}
    {{ yield warning(wType="serious", message=t(.Language, "reg-bad-password-len")) }} <br>
{{ end }}

{{ if .Data["passwordMismatch"] == true }}
    {{ yield warning(wType="serious", message=t(.Language, "reg-password-mismatch")) }} <br>
{{ end }}

{{ if .Data["serverError"] == true }}
    {{ yield warning(wType="serious", message=t(.Language, "reg-server-error")) }} <br>
{{ end }}

{{ if .Data["usernameNotUnique"] == true }}
    {{ yield warning(wType="serious", message=t(.Language, "reg-username-exists")) }} <br>
{{ end }}

{{ if .Data["emailNotUnique"] == true }}
    {{ yield warning(wType="serious", message=t(.Language, "reg-email-exists")) }} <br>
{{ end }}

<h1>{{ t(.Language, "register") }}</h1>
<form action="/register" method="post">
    <label for="username">{{ t(.Language, "web-username") }}</label>
    <input type="text" id="username" name="username">
    <br><br>

    <label for="email">E-mail</label>
    <input type="email" id="email" name="email">
    <br><br>

    <label for="password">{{ t(.Language, "web-password") }}</label>
    <input type="password" id="password" name="password">
    <br><br>

    <label for="confirm-password">{{ t(.Language, "confirm-pwd") }}</label>
    <input type="password" id="confirm-password" name="confirm-password">
    <br><br>

    <ul>
        <li>{{ t(.Language, "reg-note-1") }}</li>
        <li>{{ t(.Language, "reg-note-2") }}</li>
        <li>{{ t(.Language, "reg-note-3") }}</li>
        <li>{{ t(.Language, "reg-note-4") }}</li>
    </ul>
    <br />

    <input type="submit" value="{{ t(.Language, "register") }}">
</form>
{{ end }}
