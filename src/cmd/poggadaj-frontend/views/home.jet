{{extends "./base.jet"}}
{{ import "widgets/resetfloat.jet" }}

{{ block title() }} {{ t(.Language, "main-page") }} {{ end }}

{{block documentBody()}}
<h2 id="mainpage-h2">{{ t(.Language, "mainpage-p1") }}</h2>

<div>
    <div class="column">
        <h4 class="feature-list">{{ t(.Language, "features") }}:</h4>
        <ul class="feature-list">
            <li>{{ t(.Language, "gg6-support") }}</li>
            <li>{{ t(.Language, "no-annoying-ads") }}</li>
            <li>{{ t(.Language, "easy-installation") }}</li>
            <li>
                <a href="https://codeberg.org/or3e/poggadaj" target="_blank"
                    >{{ t(.Language, "open-source") }}</a
                >
                {{ t(.Language, "open-source-text") }}
            </li>
            <li>{{ t(.Language, "bot-compatibility") }}</li>
            <li>{{ t(.Language, "more-clients") }}</li>
        </ul>
        <br />
        <h4 class="feature-list">{{ t(.Language, "supported-clients") }}:</h4>
        <ul class="feature-list">
            <li>Gadu-Gadu 5.0</li>
            <li>Gadu-Gadu 6.0</li>
            <li>Gadu-Gadu 6.1</li>
            <li>Gadu-Gadu 7.0</li>
            <li>Gadu-Gadu 7.1</li>
            <li>Gadu-Gadu 7.5</li>
            <li>Gadu-Gadu 7.6</li>
            <li>Gadu-Gadu 7.7</li>
        </ul>
    </div>
    <div class="column">
        <img
            src="static/gg61.png"
            alt="Example screenshot of Gadu-Gadu 6.1 connected to poGGadaj"
        />
    </div>
</div>

{{ yield resetFloat() }}

<style>
    #mainpage-h2 {
        font-family: "JetBrains Mono Medium";
        font-weight: 500;
    }

    .feature-list {
        list-style-image: url("/static/brb.png");
        font-family: "Lato Regular";
    }
</style>
{{end}}
