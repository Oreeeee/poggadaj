{{ extends "./base.jet" }}
{{ import "widgets/button.jet" }}
{{ import "widgets/warning.jet" }}

{{ block title() }} {{ t(.Language, "downloads") }} {{ end }}

{{ block documentBody() }}
<h1>{{ t(.Language, "avail-clients") }}</h1>

{{ yield warning(wType="info", message=t(.Language, "connection-guide-warn"), linkUrl="/connection-guide", linkText=t(.Language, "connection-guide-href")) }}
<br/>

{{ range id, client := .Data.Clients }}
<div class="client">
    <h1 class="client-name">{{ client.Name }}</h1>
    <div class="column">
        <p class="client-description">{{ client.Description }}</p>
    </div>
    <div class="column">
        <a href="{{ client.ImageUrl }}" target="_blank">
            {* TODO: Make images smaller. IE hates this *}
            <img src={{client.ImageUrl}} alt="Screenshot of {{client.Name}} connected to poGGadaj">
        </a>
    </div>

    {{ range i, downloadLink := client.Downloads }}
        {{ buttonText := "" }}
        {{ if downloadLink.Type == 0 }}
            {{ buttonText = t(.Language, "dl-installer") }}
        {{ else if downloadLink.Type == 1 }}
            {{ buttonText = t(.Language, "dl-unpacked") }}
        {{ end }}

        {{ yield button(link=downloadLink.Url, text=buttonText, btnClass="dl-button", fixIE=.IsIE) }}
    {{ end }}
</div>

<br>
{{end}}

<style>
    .client {
        padding: 10px;
        background: #a9a9a9;
        overflow: auto;
        border: 2px solid black;
    }

    .client-name {
        text-align: left;
        font-family: 'JetBrains Mono Medium';
    }

    .client-description {
        font-family: 'Lato Regular';
    }

    .dl-button {
        width: 100%;
        height: 30px;
    }
</style>
{{ end }}
