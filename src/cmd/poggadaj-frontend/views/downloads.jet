{{extends "./base.jet"}}

{{ block title() }} {{ t(.Language, "downloads") }} {{ end }}

{{block documentBody()}}
<h1>{{ t(.Language, "avail-clients") }}</h1>

{{ range id, client := .Data.Clients }}
<div class="client">
    <h1 class="client-name">{{ client.Name }}</h1>
    <div class="column">
        <p class="client-description">{{ client.Description }}</p>

        <!--
        {#if noSSL}
        <Warning wType="serious" message={$_("no-ssl")} />
        <br>
        {/if}

        {#if insecureHash}
        <Warning wType="warn" message={$_("insecure-hash")} />
        <br>
        {/if}

        {#if modernWinProblems}
        <Warning wType="info" message={$_("modern-win-problems")} />
        {/if}
        -->
    </div>
    <div class="column">
        <img src={{client.ImageUrl}} alt="Screenshot of {{client.Name}} connected to poGGadaj">
    </div>
    {*
    <form action="{{client.DownloadUrl}}">
        <button type="submit" class="dl-button">{{ t(.Language, "download") }}</button>
    </form>*}
</div>

<br>
{{end}}

<style>
    .client {
        padding: 10px;
        background-color: darkgrey;
        height: auto;
        overflow-y: auto;
        border: 2px solid black;
    }

    .client-name {
        text-align: left;
        font-family: 'JetBrains Mono Medium';
    }

    .client-description {
        font-family: 'Lato Regular';
    }

    .dl-button {
        width: 100%;
        height: 30px;
    }
</style>
{{end}}
